{
  "name": "speekly-desktop",
  "version": "1.0.0",
  "description": "Speekly — десктопный мессенджер на Supabase",
  "main": "main.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "test": "node tests/crypto.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.speekly.desktop",
    "productName": "Speekly",
    "files": ["main.js", "preload.js", "src/**/*", "build/icon.png", "node_modules/**/*", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}